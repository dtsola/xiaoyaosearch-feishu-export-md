{
  "name": "xiaoyaosearch-feishu-export",
  "version": "1.0.0",
  "description": "小遥搜索飞书导出工具 - 飞书文档/知识库导出为 Markdown 的 CLI 工具",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "feishu-export": "./bin/feishu-export.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "build:binary": "pkg dist/index.js --output dist/feishu-export",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:integration": "vitest --config tests/integration/vitest.config.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "feishu",
    "lark",
    "export",
    "markdown",
    "cli"
  ],
  "author": "xiaoyaosearch",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyaosearch/xiaoyaosearch-feishu-export-md.git"
  },
  "bugs": {
    "url": "https://github.com/xiaoyaosearch/xiaoyaosearch-feishu-export-md/issues"
  },
  "homepage": "https://github.com/xiaoyaosearch/xiaoyaosearch-feishu-export-md#readme",
  "dependencies": {
    "axios": "^1.7.9",
    "bottleneck": "^2.19.5",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "fs-extra": "^11.3.0",
    "inquirer": "^9.3.7",
    "marked": "^17.0.5",
    "marked-xhtml": "^1.0.14",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.8",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "pkg": "^5.8.1",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
